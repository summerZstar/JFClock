<?xml version="1.0" encoding="utf-8"?>
<!-- 定时开始的时刻选择：和时长一样用滚轮拨时/分 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <com.example.jfclock.WheelPicker
            android:id="@+id/pickerStartHour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:wheelItemTextSize="24sp"
            app:wheelMaxValue="23"
            app:wheelMinValue="0"
            app:wheelVisibleCount="3"
            app:wheelWrapSelectorWheel="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unit_hour"
            android:textSize="12sp"
            android:textColor="@color/light_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <com.example.jfclock.WheelPicker
            android:id="@+id/pickerStartMinute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:wheelItemTextSize="24sp"
            app:wheelMaxValue="59"
            app:wheelMinValue="0"
            app:wheelVisibleCount="3"
            app:wheelWrapSelectorWheel="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/unit_minute"
            android:textSize="12sp"
            android:textColor="@color/light_text_secondary" />
    </LinearLayout>
</LinearLayout>
