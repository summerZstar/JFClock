<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/light_bg"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/egg_timer"
        app:titleTextColor="@color/light_text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 倒计时 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/light_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/tvCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="06:00"
                        android:textSize="52sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:textColor="@color/light_text_primary" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="@color/light_accent" />

                    <TextView
                        android:id="@+id/tvFormula"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:textColor="@color/light_text_secondary" />

                    <ProgressBar
                        android:id="@+id/progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="12dp"
                        android:max="1000"
                        android:progress="0"
                        android:progressTint="@color/light_accent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 配置：熟度 / 大小 / 冷藏 / 自定义，合并成一张卡 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/light_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <!-- 熟度 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:minHeight="46dp">

                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:text="@string/egg_doneness_short"
                            android:textSize="13sp"
                            android:textColor="@color/light_text_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSoft"
                            style="@style/EggChip"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/egg_soft" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMedium"
                            style="@style/EggChip"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/egg_medium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHard"
                            style="@style/EggChip"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/egg_hard" />

                        <ImageButton
                            android:id="@+id/btnEditPresets"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_settings"
                            android:scaleType="centerInside"
                            android:tint="@color/light_icon"
                            android:contentDescription="@string/egg_preset_settings" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/light_divider" />

                    <!-- 大小 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:minHeight="46dp">

                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:text="@string/egg_size_short"
                            android:textSize="13sp"
                            android:textColor="@color/light_text_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSizeM"
                            style="@style/EggChip"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/egg_size_m" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSizeL"
                            style="@style/EggChip"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/egg_size_l" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSizeXl"
                            style="@style/EggChip"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/egg_size_xl" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/light_divider" />

                    <!-- 冷藏蛋 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:minHeight="46dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/egg_fridge"
                            android:textSize="13sp"
                            android:textColor="@color/light_text_secondary" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swFridge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:trackTint="@color/switch_track"
                            app:thumbTint="@color/switch_thumb" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/light_divider" />

                    <!-- 自定义时长：点开对话框设定，替代原来的高滚轮 -->
                    <LinearLayout
                        android:id="@+id/btnCustom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="46dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/egg_custom_row"
                            android:textSize="13sp"
                            android:textColor="@color/light_text_secondary" />

                        <TextView
                            android:id="@+id/tvCustomValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/egg_custom_off"
                            android:textSize="14sp"
                            android:textColor="@color/light_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/egg_row_arrow"
                            android:textSize="14sp"
                            android:textColor="@color/light_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 开始 / 停止 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/egg_start"
                    android:textSize="16sp"
                    android:backgroundTint="@color/light_accent"
                    app:cornerRadius="25dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStop"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/egg_stop"
                    android:textSize="16sp"
                    android:textColor="@color/light_accent"
                    app:cornerRadius="25dp"
                    app:strokeColor="@color/light_accent" />
            </LinearLayout>

            <!-- 煮法说明：默认折叠，不占首屏 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/light_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btnGuide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/egg_guide_title"
                            android:textSize="15sp"
                            android:textColor="@color/light_text_primary" />

                        <TextView
                            android:id="@+id/tvGuideToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/egg_guide_expand"
                            android:textSize="13sp"
                            android:textColor="@color/light_text_secondary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvGuideBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/egg_guide_body"
                        android:textSize="13sp"
                        android:textColor="@color/light_text_secondary"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
