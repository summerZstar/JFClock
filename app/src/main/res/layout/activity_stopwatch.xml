<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/light_bg"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/sw_title"
        app:titleTextColor="@color/light_text_primary" />

    <TextView
        android:id="@+id/tvSwTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="00:00.00"
        android:textSize="52sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-light"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textColor="@color/light_text_primary" />

    <TextView
        android:id="@+id/tvSwStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="@color/light_text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwStart"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/sw_start"
            android:textSize="16sp"
            android:backgroundTint="@color/light_accent"
            app:cornerRadius="25dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwLap"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="@string/sw_lap"
            android:textSize="14sp"
            android:textColor="@color/light_accent"
            app:cornerRadius="25dp"
            app:strokeColor="@color/light_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwReset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/sw_reset"
            android:textSize="14sp"
            android:textColor="@color/light_accent"
            app:cornerRadius="25dp"
            app:strokeColor="@color/light_accent" />
    </LinearLayout>

    <!-- 计次表头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="@string/sw_lap_count"
            android:textSize="12sp"
            android:textColor="@color/light_text_secondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/sw_lap_split"
            android:textSize="12sp"
            android:textColor="@color/light_text_secondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/sw_lap_total"
            android:textSize="12sp"
            android:textColor="@color/light_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/light_divider" />

    <ScrollView
        android:id="@+id/lapScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/lapContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp" />
    </ScrollView>

</LinearLayout>
