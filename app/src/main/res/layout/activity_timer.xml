<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/light_bg"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/timer_title"
        app:titleTextColor="@color/light_text_primary" />

    <ScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <!-- 圆环 + 中心倒计时（ColorOS 计时器样式）：仅启动/暂停/定时等待时显示，
                 设置时长时隐藏（对齐 ColorOS：设置页只看滚轮） -->
            <FrameLayout
                android:id="@+id/ringGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/ring"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="1000"
                    android:progress="0"
                    app:indicatorColor="@color/light_accent"
                    app:indicatorSize="232dp"
                    app:trackColor="@color/light_divider"
                    app:trackThickness="5dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="42sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-light"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:textColor="@color/light_text_primary" />

                    <TextView
                        android:id="@+id/tvTimerLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:gravity="center"
                        android:textSize="13sp"
                        android:textColor="@color/light_accent" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textSize="11sp"
                android:textColor="@color/light_text_secondary" />

            <!-- 时/分/秒滚轮：停表状态下才让拨 -->
            <LinearLayout
                android:id="@+id/dialGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.example.jfclock.WheelPicker
                        android:id="@+id/pickerHour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:wheelItemTextSize="26sp"
                        app:wheelMaxValue="23"
                        app:wheelMinValue="0"
                        app:wheelVisibleCount="3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/unit_hour"
                        android:textSize="12sp"
                        android:textColor="@color/light_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.example.jfclock.WheelPicker
                        android:id="@+id/pickerMinute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:wheelItemTextSize="26sp"
                        app:wheelMaxValue="59"
                        app:wheelMinValue="0"
                        app:wheelVisibleCount="3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/unit_minute"
                        android:textSize="12sp"
                        android:textColor="@color/light_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.example.jfclock.WheelPicker
                        android:id="@+id/pickerSecond"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:wheelItemTextSize="26sp"
                        app:wheelMaxValue="59"
                        app:wheelMinValue="0"
                        app:wheelVisibleCount="3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/unit_second"
                        android:textSize="12sp"
                        android:textColor="@color/light_text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- 我们的特色：固定分钟 / 固定秒钟一键增减。
                 三列各配一个迷你档位滚轮 + 左右减/加按钮：滚到想加的档位，点一侧就加，
                 点另一侧就减，可连点累加，不需要横向滚动。 -->
            <LinearLayout
                android:id="@+id/quickGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/timer_quick_add"
                    android:textSize="12sp"
                    android:textColor="@color/light_text_secondary" />

                <LinearLayout
                    android:id="@+id/rowDeltaCols"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false" />
            </LinearLayout>

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_timer_name"
                android:hint="@string/timer_name_hint"
                android:textSize="14sp"
                android:textColor="@color/light_text_primary"
                android:textColorHint="@color/light_text_secondary"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:importantForAutofill="no" />

            <!-- 定时开始：选一个时刻，到点才开始倒数（到点后按上面拨的时长计时） -->
            <LinearLayout
                android:id="@+id/rowScheduledStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timer_scheduled_title"
                    android:textSize="14sp"
                    android:textColor="@color/light_text_primary" />

                <!-- 摘要与开关同排：整行一句话，不再另起一行（长文案在这里省略号收尾） -->
                <TextView
                    android:id="@+id/tvScheduledSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/timer_scheduled_off_summary"
                    android:textSize="12sp"
                    android:textColor="@color/light_text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchScheduled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:trackTint="@color/switch_track"
                    app:thumbTint="@color/switch_thumb" />
            </LinearLayout>

            <!-- 常用计时器：预设一键开始，可添加/编辑/删除（参考 ColorOS） -->
            <LinearLayout
                android:id="@+id/presetGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/timer_preset_section"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/light_text_primary" />

                    <TextView
                        android:id="@+id/btnPresetAdd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/timer_preset_add"
                        android:textSize="14sp"
                        android:textColor="@color/light_accent"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/timer_preset_drag_hint"
                        android:textSize="11sp"
                        android:textColor="@color/light_text_secondary" />

                    <!-- 预设列表：点击套用、长按编辑、按右侧手柄上下拖动排序，
                         列表本身不滚动（外层 ScrollView 负责滚动） -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/presetList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:scrollbars="none" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/timer_guide_body"
                android:textSize="12sp"
                android:textColor="@color/light_text_secondary" />

        </LinearLayout>
    </ScrollView>

    <!-- 「开始 / 重置」固定在页面底部，无需滚动、始终在第一屏可见 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/light_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="76dp"
            android:layout_marginEnd="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/timer_reset"
            android:textSize="13sp"
            android:textColor="@color/light_accent"
            app:cornerRadius="22dp"
            app:strokeColor="@color/light_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/timer_start"
            android:textSize="16sp"
            android:backgroundTint="@color/light_accent"
            app:cornerRadius="25dp" />
    </LinearLayout>

</LinearLayout>
