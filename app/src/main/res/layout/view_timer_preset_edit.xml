<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp">

        <EditText
            android:id="@+id/etPresetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/timer_preset_name_hint"
            android:textSize="15sp"
            android:inputType="text"
            android:maxLines="1"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/timer_preset_duration"
            android:textSize="12sp"
            android:textColor="@color/light_text_secondary" />

        <!-- 时长：时/分/秒三列滚轮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.example.jfclock.WheelPicker
                    android:id="@+id/pickerPresetHour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:wheelItemTextSize="18sp"
                    app:wheelMaxValue="23"
                    app:wheelMinValue="0"
                    app:wheelVisibleCount="3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_hour"
                    android:textSize="11sp"
                    android:textColor="@color/light_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.example.jfclock.WheelPicker
                    android:id="@+id/pickerPresetMinute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:wheelItemTextSize="18sp"
                    app:wheelMaxValue="59"
                    app:wheelMinValue="0"
                    app:wheelVisibleCount="3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_minute"
                    android:textSize="11sp"
                    android:textColor="@color/light_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.example.jfclock.WheelPicker
                    android:id="@+id/pickerPresetSecond"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:wheelItemTextSize="18sp"
                    app:wheelMaxValue="59"
                    app:wheelMinValue="0"
                    app:wheelVisibleCount="3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_second"
                    android:textSize="11sp"
                    android:textColor="@color/light_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 类型开关：关掉=随时倒计时的预设，打开=每天到点播的「定时开始」预设 -->
        <LinearLayout
            android:id="@+id/rowPresetScheduled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timer_scheduled_title"
                    android:textSize="14sp"
                    android:textColor="@color/light_text_primary" />

                <TextView
                    android:id="@+id/tvPresetScheduledHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/timer_preset_scheduled_off_hint"
                    android:textSize="11sp"
                    android:textColor="@color/light_text_secondary" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPresetScheduled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:trackTint="@color/switch_track"
                app:thumbTint="@color/switch_thumb" />
        </LinearLayout>

        <!-- 开始时刻：时/分滚轮，仅在开关打开时可见 -->
        <LinearLayout
            android:id="@+id/groupPresetStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.example.jfclock.WheelPicker
                    android:id="@+id/pickerPresetStartHour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:wheelItemTextSize="18sp"
                    app:wheelMaxValue="23"
                    app:wheelMinValue="0"
                    app:wheelVisibleCount="3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_hour"
                    android:textSize="11sp"
                    android:textColor="@color/light_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.example.jfclock.WheelPicker
                    android:id="@+id/pickerPresetStartMinute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:wheelItemTextSize="18sp"
                    app:wheelMaxValue="59"
                    app:wheelMinValue="0"
                    app:wheelVisibleCount="3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_minute"
                    android:textSize="11sp"
                    android:textColor="@color/light_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
